# Set LLM_PROVIDER explicitly, or leave unset to auto-detect (gemini if GEMINI_API_KEY is set).
LLM_PROVIDER=gemini

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier allows few requests/day per model; switch model if you hit 429 RESOURCE_EXHAUSTED
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (optional, first-class path but not required)
ANTHROPIC_API_KEY=
